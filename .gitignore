# Dependencies
node_modules/

# Build output — regenerated by `partykit dev`/`deploy` from src/client.ts
# (see partykit.json's `serve.build`); the rest of server/public/ is source.
server/public/dist/

# Local tool state — regenerated on demand, machine-specific
server/.partykit/
server/.wrangler/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Environment variables / secrets — never commit these
.env
.env.*
.dev.vars

# Editor / OS cruft — server/.vscode/ is intentionally NOT ignored: it's
# scaffold-provided project config (partykit.json schema association,
# PartyKit debugger attach settings), not personal editor state.
.DS_Store
Thumbs.db

# Session-local lock file (PID + timestamp, machine-specific)
.claude/scheduled_tasks.lock

# Personal task notes — local only
user_todo.txt
